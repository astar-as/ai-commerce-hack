OPENAI_API_KEY=
# platform.zoowork.ai → API keys → Create (shown once). Set → /api/delegate uses ZooWork
ZOOWORK_API_KEY=
# written by `npm run agent:setup`
ZOOWORK_AGENT_ID=
# optional: force a model alias from listModels()
# ZOOWORK_MODEL=
ZOOWORK_BASE_URL=https://clawapi.ecap.gsmo.ai/service/v1

# Which catalog the tools use: kroger (default, real data) | synthetic (offline Safeway-style fallback)
CATALOG_SOURCE=kroger

# Moss (moss.dev → project). Without these, search falls back to local keyword search.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Defaults to "<CATALOG_SOURCE>-catalog"
MOSS_INDEX=

# Kroger Public API (developer.kroger.com): products, aisles, stock — app keys only, no shopper login
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ZIP=45202
KROGER_LOCATION_ID=

# optional: without it, delivery uses the mock cart page
INSTACART_API_KEY=
# APP_URL=http://localhost:3000

# 1 = tools return fixtures from mocks/ instead of real data
MOCK_TOOLS=1
