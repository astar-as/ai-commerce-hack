# Copy to .env.local (git-ignored). Backend only — never expose to the browser.
ZOOWORK_API_KEY=            # platform.zoowork.ai → API keys → Create (shown once)
ZOOWORK_AGENT_ID=           # written by `npm run agent:setup`
# ZOOWORK_MODEL=            # optional: force a model alias from listModels()
INSTACART_API_KEY=          # optional: without it, delivery returns a mock cart link
# INSTACART_BASE_URL=https://connect.dev.instacart.tools
# APP_URL=http://localhost:3000
