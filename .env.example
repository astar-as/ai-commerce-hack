OPENAI_API_KEY=
ZOOWORK_API_KEY=
ZOOWORK_BASE_URL=https://clawapi.ecap.gsmo.ai/service/v1

# Which catalog the tools use: synthetic (default, works offline) | kroger (after npm run kroger:import)
CATALOG_SOURCE=synthetic

# Moss (moss.dev → project). Without these, search falls back to local keyword search.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Defaults to "<CATALOG_SOURCE>-catalog"
MOSS_INDEX=

# Kroger Public API (developer.kroger.com → register app): products, aisles, stock, cart
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ZIP=45202
KROGER_LOCATION_ID=

INSTACART_API_KEY=

# 1 = tools return fixtures from mocks/ instead of real data
MOCK_TOOLS=1
